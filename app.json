{
  "expo": {
    "name": "호랑잉글리시",
    "slug": "horang-english",
    "owner": "her-use",
    "scheme": "horang-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-1.png",
          "imageWidth": 393,
          "resizeMode": "contain",
          "backgroundColor": "#fffbe8"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heruse.horang",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "자랑하기 리포트를 사진 앱에 저장할 때 필요합니다."
      }
    },
    "android": {
      "package": "com.heruse.horang",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cac2590-db5e-40b1-8fdb-d061058ea841"
      }
    }
  }
}
